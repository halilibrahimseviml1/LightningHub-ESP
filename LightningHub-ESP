-- ======================= ESP MOTORU (DEĞİŞMEDİ) =======================
local espCache = {}

local function removeESP(player)
    if espCache[player] then
        if espCache[player].folder then
            espCache[player].folder:Destroy()
        end
        espCache[player] = nil
    end
end

local function createESP(player)
    removeESP(player)
    
    local folder = Instance.new("Folder")
    folder.Name = "ESP_" .. player.Name
    folder.Parent = workspace
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = folder
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESPBillboard"
    billboard.Size = UDim2.new(0, 150, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = folder
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "ESPText"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextStrokeTransparency = 0
    textLabel.TextSize = 12
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextWrapped = true
    textLabel.Parent = billboard
    
    espCache[player] = {
        folder = folder,
        highlight = highlight,
        billboard = billboard,
        textLabel = textLabel
    }
end

RunService.RenderStepped:Connect(function()
    if not Settings.enabled then
        for _, data in pairs(espCache) do
            if data.folder then data.folder.Parent = nil end
        end
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local humRootPart = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChild("Humanoid")
            local head = char and char:FindFirstChild("Head")
            
            if char and humRootPart and humanoid and head and humanoid.Health > 0 then
                local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local dist = myRoot and (myRoot.Position - humRootPart.Position).Magnitude or 0
                
                if dist <= Settings.maxDistance then
                    local showThis = true
                    if Settings.filter == "Team" and player.Team ~= LocalPlayer.Team then showThis = false end
                    if Settings.filter == "Enemy" and player.Team == LocalPlayer.Team and player.Team ~= nil then showThis = false end
                    
                    if showThis then
                        if not espCache[player] or not espCache[player].folder or espCache[player].folder.Parent ~= workspace then
                            createESP(player)
                        end
                        
                        local cache = espCache[player]
                        cache.folder.Parent = workspace
                        cache.highlight.Adornee = char
                        cache.billboard.Adornee = head
                        
                        local col = Color3.fromRGB(255, 255, 0)
                        if Settings.teamColor and player.Team and LocalPlayer.Team then
                            if player.Team == LocalPlayer.Team then
                                col = Color3.fromRGB(0, 255, 0)
                            else
                                col = Color3.fromRGB(255, 0, 0)
                            end
                        end
                        
                        cache.highlight.FillColor = col
                        cache.highlight.OutlineColor = col
                        cache.highlight.Enabled = Settings.box
                        
                        if Settings.chams then
                            cache.highlight.FillTransparency = 0.3
                        else
                            cache.highlight.FillTransparency = 1
                        end
                        
                        local textParts = {}
                        if Settings.name then table.insert(textParts, player.Name) end
                        if Settings.health then table.insert(textParts, "HP: " .. math.floor(humanoid.Health)) end
                        if Settings.distance then table.insert(textParts, math.floor(dist) .. "m") end
                        
                        cache.textLabel.Text = table.concat(textParts, "\n")
                        cache.billboard.Enabled = (Settings.name or Settings.health or Settings.distance)
                    else
                        removeESP(player)
                    end
                else
                    removeESP(player)
                end
            else
                removeESP(player)
            end
        end
    end
end)

